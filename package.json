{
  "name": "dsh-desktop",
  "version": "1.0.4",
  "description": "DeepSeek Harness desktop wrapper: bundled server + UI with tray",
  "main": "main.js",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "package:mac": "electron-builder --mac dir --arm64",
    "dist:mac": "electron-builder --mac dmg --arm64",
    "package:win": "electron-builder --win nsis --x64",
    "icon:mac": "node scripts/convert-mac-icon.mjs"
  },
  "dependencies": {
    "@deepseek-ai/cordis-plugin-group": "1.0.1",
    "@deepseek-ai/dsh": "0.1.0-rc.6",
    "js-yaml": "^4.3.1",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "electron": "^37.2.0",
    "electron-builder": "26.15.3",
    "png-to-ico": "^3.0.2",
    "sharp": "^0.35.3"
  },
  "build": {
    "appId": "com.deepseek.harness.desktop",
    "productName": "DeepSeek Harness",
    "asar": true,
    "files": [
      "main.js",
      "desktop-preload.js",
      "desktop-services.js",
      "package.json",
      "assets/**/*",
      "bundled-skills/**/*",
      "bundled-plugins/**/*"
    ],
    "extraResources": [
      {
        "from": "bundled-skills",
        "to": "bundled-skills"
      },
      {
        "from": "bundled-plugins",
        "to": "bundled-plugins"
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "assets/deepseek.icns",
      "identity": "-",
      "hardenedRuntime": false,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ]
    },
    "dmg": {
      "artifactName": "${productName}-${version}-mac-${arch}.${ext}"
    },
    "win": {
      "icon": "assets/deepseek.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
